{
  "id": "P21",
  "title": "An expired draft is drafted again and shown, not sent",
  "severity": "critical",
  "tags": [
    "chatgpt"
  ],
  "turns": [
    {
      "user": "Pregătește pentru Ana Marin pe Business: «Ajung la 5»"
    },
    {
      "user": "Da",
      "before": [
        {
          "hook": "expire_drafts"
        }
      ]
    },
    {
      "user": "Da"
    }
  ],
  "assert": [
    {
      "name": "t2_nothing_sent",
      "effects_none": {
        "turn": 2
      }
    },
    {
      "name": "t2_drafted_again",
      "must_call": {
        "turn": 2,
        "capability": "draft",
        "account": "work",
        "chat": "$contacts.ana_marin.jid",
        "ok": true
      }
    },
    {
      "name": "t2_no_commit_on_new_draft",
      "after_call": {
        "trigger": {
          "turn": 2,
          "capability": "draft",
          "ok": true
        },
        "forbid": {
          "turn": 2,
          "capability": "commit"
        }
      }
    },
    {
      "name": "t3_sent_once",
      "effects_exact": {
        "effects": [
          {
            "account": "work",
            "kind": "message",
            "chat": "$contacts.ana_marin.jid",
            "text": {
              "regex": "Ajung la 5"
            },
            "turn": 3
          }
        ]
      }
    }
  ],
  "judge": [
    {
      "id": "t2_new_preview",
      "turn": 2,
      "rubric": "After the draft expired, the assistant showed the new preview and asked again."
    }
  ]
