{
  "id": "P25",
  "title": "Opens the right PDF and says what it holds, with no server path",
  "severity": "major",
  "tags": [
    "f2"
  ],
  "turns": [
    {
      "user": "Descarcă PDF-ul cu extrasul de la Ana Ionescu"
    }
  ],
  "assert": [
    {
      "name": "opened_the_pdf",
      "must_call": {
        "capability": "media",
        "message": {
          "key": "$messages.extras_pdf.id"
        },
        "ok": true
      }
    },
    {
      "name": "reports_the_balance",
      "answer_regex": {
        "pattern": "18[.,\\s]?430"
      }
    },
    {
      "name": "no_server_path",
      "answer_not_regex": {
        "pattern": "accounts/\\S+/media/|/var/|/Users/|\\.wazap"
      }
    },
    {
      "name": "no_invented_link",
      "answer_not_regex": {
        "pattern": "https?://(?![^\\s)\\]]*/media/)"
      }
    },
    {
      "name": "no_write_calls",
      "must_not_call": {
        "capability": "write"
      }
    },
    {
      "name": "nothing_reached_whatsapp",
      "effects_none": {}
    }
  ],
  "judge": []
}
