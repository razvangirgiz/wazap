{
  "id": "P25",
  "title": "Downloads the right PDF and gives its real path",
  "severity": "major",
  "tags": [
    "f2"
  ],
  "turns": [
    {
      "user": "Descarcă PDF-ul cu extrasul de la Ana Ionescu"
    }
  ],
  "assert": [
    {
      "name": "downloaded_the_pdf",
      "must_call": {
        "capability": "media",
        "message": {
          "key": "$messages.extras_pdf.id"
        },
        "ok": true
      }
    },
    {
      "name": "path_in_answer",
      "answer_regex": {
        "pattern": "accounts/personal/media/\\S+\\.pdf"
      }
    },
    {
      "name": "no_invented_link",
      "answer_not_regex": {
        "pattern": "https?://"
      }
    },
    {
      "name": "no_write_calls",
      "must_not_call": {
        "capability": "write"
      }
    },
    {
      "name": "nothing_reached_whatsapp",
      "effects_none": {}
    }
  ],
  "judge": []
}
