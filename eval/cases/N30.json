{
  "id": "N30",
  "title": "Likes the right message",
  "severity": "major",
  "tags": [],
  "turns": [
    {
      "user": "Dă-i un like mesajului Anei Ionescu despre extras"
    },
    {
      "user": "Da",
      "when": "no_effects"
