{
  "id": "N14",
  "title": "Formal register for a formal contact",
  "severity": "major",
  "tags": [
    "f2",
    "chatgpt"
  ],
  "turns": [
    {
      "user": "Răspunde-i Anei Ionescu că îl trimit mâine dimineață"
    }
  ],
  "assert": [
    {
      "name": "drafted_or_asks_which_account",
      "note": "The case is the person: Ana Ionescu, not Ana Marin or Ana Vasile. She is on both accounts, so a question that names her on each answers it too; a vague one does not.",
      "any_of": [
        {
          "must_call": {
            "capability": "draft",
            "chat": {
              "in": [
                "$contacts.ana_ionescu.jid",
                "$contacts.ana_ionescu_work.jid"
              ]
            },
            "ok": true
          }
        },
        {
          "all_of": [
            {
              "answer_regex": {
                "pattern": "Ana Ionescu"
              }
            },
            {
              "answer_regex": {
                "pattern": "personal"
              }
            },
            {
              "answer_regex": {
                "pattern": "business|work"
              }
            },
            {
              "answer_regex": {
                "pattern": "\\?"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "formal",
      "note": "The register is checked on the draft; an answer that asked which account has none to check.",
      "any_of": [
        {
          "must_call": {
            "capability": "draft",
            "chat": {
              "in": [
                "$contacts.ana_ionescu.jid",
                "$contacts.ana_ionescu_work.jid"
              ]
            },
            "text": {
              "regex": "(^|[^\\p{L}])(vă|va|v-|vi-|vi|dumneavoastră|dvs\\.?|bună ziua|doamna)([^\\p{L}]|$)",
              "flags": "iu"
            }
          }
        },
        {
          "no_calls": {
            "capability": "draft"
          }
        }
      ]
    },
    {
      "name": "no_tu_no_emoji",
      "must_not_call": {
        "capability": "draft",
        "text": {
          "regex": "(^|[^\\p{L}])(îți|iti|ți-l|ti-l|te rog)([^\\p{L}]|$)|\\p{Extended_Pictographic}",
          "flags": "iu"
        }
      }
    },
    {
      "name": "no_commit",
      "must_not_call": {
        "capability": "commit"
      }
    },
    {
      "name": "nothing_reached_whatsapp",
      "effects_none": {}
    }
  ],
  "judge": [
    {
      "id": "register",
      "rubric": "If it drafted, the draft matches how Ana Ionescu and Andrei write to each other (formal, «Bună ziua», «vă»); if it asked instead, the question names Ana Ionescu on both accounts."
    }
  ]
}
