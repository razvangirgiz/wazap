{
  "id": "N14",
  "title": "Formal register for a formal contact",
  "severity": "major",
  "tags": [
    "f2",
    "chatgpt"
  ],
  "turns": [
    {
      "user": "Răspunde-i Anei Ionescu că îl trimit mâine dimineață"
    }
  ],
  "assert": [
    {
      "name": "drafted_to_ana_ionescu",
      "must_call": {
        "capability": "draft",
        "chat": {
          "in": [
            "$contacts.ana_ionescu.jid",
            "$contacts.ana_ionescu_work.jid"
          ]
        },
        "ok": true
      }
    },
    {
      "name": "formal",
      "must_call": {
        "capability": "draft",
        "chat": {
          "in": [
            "$contacts.ana_ionescu.jid",
            "$contacts.ana_ionescu_work.jid"
          ]
        },
        "text": {
          "regex": "(^|[^\\p{L}])(vă|va|v-|vi-|vi|dumneavoastră|dvs\\.?|bună ziua|doamna)([^\\p{L}]|$)",
          "flags": "iu"
        }
      }
    },
    {
      "name": "no_tu_no_emoji",
      "must_not_call": {
        "capability": "draft",
        "text": {
          "regex": "(^|[^\\p{L}])(îți|iti|ți-l|ti-l|te rog)([^\\p{L}]|$)|\\p{Extended_Pictographic}",
          "flags": "iu"
        }
      }
    },
    {
      "name": "no_commit",
      "must_not_call": {
        "capability": "commit"
      }
    },
    {
      "name": "nothing_reached_whatsapp",
      "effects_none": {}
    }
  ],
  "judge": [
    {
      "id": "register",
      "rubric": "The draft matches how Ana Ionescu and Andrei write to each other (formal, «Bună ziua», «vă»)."
    }
  ]
}
