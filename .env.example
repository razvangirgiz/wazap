# Copy to .env and adjust. Every setting is optional.
# cp .env.example .env

# --- WhatsApp session -----------------------------------------------------------
# Folder where the session is stored, so you scan the QR once.
# WHATSAPP_AUTH_PATH=.baileys_auth

# Path of the QR PNG written on first login (open it and scan with your phone).
# QR_FILE=qr.png

# Refuse every send/mutation on this connection. Useful when the linked account
# is your personal number and the server should only ever read.
# WHATSAPP_READONLY=0

# Ask WhatsApp for a fuller history sync on connect.
# WHATSAPP_SYNC_FULL_HISTORY=0

# Persistence (all paths relative to the package root). Leave unset to keep
# everything in memory.
# WHATSAPP_STORE_CACHE=.store-cache.json        # chat list + recent messages snapshot
# WHATSAPP_HISTORY_STORE_DIR=history            # per-chat JSONL history
# WHATSAPP_JOURNAL_DIR=journal                  # append-only message journal

# --- MCP transport ----------------------------------------------------------------
# "stdio" (default) for Claude Desktop / Claude Code.
# "http" exposes a Streamable HTTP server at http://HOST:PORT/mcp.
# TRANSPORT=stdio
# HOST=127.0.0.1
# PORT=8766

# Read token for the http /mcp endpoint. REQUIRED before exposing the server
# beyond localhost. Generate with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Write token. Only sessions authenticated with this token get the mutating
# tools (send, media, react, forward, delete, manage). Keep it separate from the
# read token so a leaked read token can never message anyone.
# MCP_WRITE_TOKEN=
