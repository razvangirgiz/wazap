# wazap settings. Copy to ~/.wazap/.env (or <data-dir>/.env) and uncomment what
# you need — every setting is optional, and a real environment variable always
# wins over this file. Command-line flags win over both.

# Where wazap keeps auth/, media/, history/, store.json and server.lock.
# WAZAP_DATA_DIR=~/.wazap

# Refuse every write. The send/manage tools are not registered at all, so an
# agent cannot message anyone from this account even by mistake.
# WAZAP_READ_ONLY=0

# Ask WhatsApp for a fuller history sync on connect. Slower to start.
# WAZAP_SYNC_FULL_HISTORY=0

# Keep chats and messages under the data dir so they survive a restart.
# WAZAP_PERSIST_HISTORY=1

# Token bucket over the write tools, per minute. 0 disables the limit.
# Sending faster than this is how accounts get banned.
# WAZAP_RATE_LIMIT=20

# --- HTTP transport (the default is stdio, for Claude Desktop / Claude Code) ---
# WAZAP_TRANSPORT=stdio
# WAZAP_HOST=127.0.0.1
# WAZAP_PORT=8766

# Bearer token for GET/POST /mcp. REQUIRED to bind anything but loopback.
# Generate with: openssl rand -hex 32
# WAZAP_READ_TOKEN=

# Only sessions presenting this token get the write tools, so a leaked read
# token can never message anyone.
# WAZAP_WRITE_TOKEN=

# --- OAuth, for agents that cannot carry a header (claude.ai, ChatGPT, Poke) ---
# Both together turn it on. The URL is where agents reach this server from the
# outside and must be https. The password is what the consent page asks you
# for; generate with: openssl rand -base64 18
# WAZAP_PUBLIC_URL=https://wazap.example.com
# WAZAP_OAUTH_PASSWORD=
