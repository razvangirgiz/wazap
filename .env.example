# wazap settings. Copy to ~/.wazap/.env (or <data-dir>/.env) and uncomment what
# you need — every setting is optional, and a real environment variable always
# wins over this file. Command-line flags win over both.

# Where wazap keeps accounts.json, accounts/<id>/, models/ and server.lock.
# WAZAP_DATA_DIR=~/.wazap

# Refuse every write. The send/manage tools are not registered at all, so an
# agent cannot message anyone from this account even by mistake. Unset and 0
# both allow writes. 1 turns them off until `wazap config writes on` and a restart.
# Invalid values are refused. Durable per-account restrictions live in accounts.json.
# WAZAP_READ_ONLY=0

# Ask WhatsApp for a fuller history sync on connect. Slower to start.
# WAZAP_SYNC_FULL_HISTORY=0

# Keep chats and messages under the data dir so they survive a restart.
# Content-free deletion barriers (retention.json) remain even with 0.
# WAZAP_PERSIST_HISTORY=1

# Strict retention, off by default. On: messages marked as disappearing expire
# locally at their earliest known deadline (keep-in-chat is not an exemption, and
# a marked message with an uncomputable timer is refused), and starting with
# WAZAP_PERSIST_HISTORY=0 discards history, snapshot and recall caches an earlier
# history-on run left. Deleted messages are forgotten either way. See README.
# WAZAP_RETENTION=0

# Token bucket over the write tools, per minute. 0 disables the limit.
# Sending faster than this is how accounts get banned. HTTP POST and in-flight
# tool budgets are separate safety limits and are not disabled by 0.
# WAZAP_RATE_LIMIT=20

# Tool calls one MCP session may have running at once, and all sessions together.
# Agents send several calls in parallel, and wait_for_messages holds a slot for up
# to 55 s; past the limit a call answers RATE_LIMITED. Zero or junk keeps the default.
# WAZAP_MAX_INFLIGHT=8
# WAZAP_MAX_INFLIGHT_TOTAL=32

# HTTP POSTs to /mcp per credential per minute (Retry-After when exceeded).
# WAZAP_HTTP_BUDGET=240

# --- HTTP transport (the default is stdio, for Claude Desktop / Claude Code) ---
# WAZAP_TRANSPORT=stdio
# WAZAP_HOST=127.0.0.1
# WAZAP_PORT=8766

# Bearer token for GET/POST /mcp. REQUIRED to bind anything but loopback.
# Generate with: openssl rand -hex 32
# WAZAP_READ_TOKEN=

# Only sessions presenting this token get the write tools, so a leaked read
# token can never message anyone. The token is not the same as writes being
# enabled: WAZAP_READ_ONLY=1 hides write tools from every session.
# WAZAP_WRITE_TOKEN=

# --- OAuth, for agents that cannot carry a header (claude.ai, ChatGPT, Poke) ---
# Both together turn it on. The URL is where agents reach this server from the
# outside and must be https. The password is what the consent page asks you
# for; generate with: openssl rand -base64 18
# Clients must save rotated refresh tokens and serialize refresh calls; see README.
# WAZAP_PUBLIC_URL=https://wazap.example.com
# WAZAP_OAUTH_PASSWORD=

# OAuth proxy trust for X-Forwarded-For and rate limits. Default: loopback only.
# Use "none" when there is no reverse proxy; otherwise name only trusted proxy
# IPs/CIDRs, comma-separated (e.g. loopback,172.20.0.2/32). Not whole LANs.
# A trusted proxy MUST overwrite/sanitize incoming X-Forwarded-For. Private IPs
# are not automatically trusted. CF-Connecting-IP alone is ignored: configure
# your Cloudflare/tunnel ingress to supply a trustworthy X-Forwarded-For chain.
# Restart after changing this. This does not grant MCP or local-file access.
# WAZAP_TRUST_PROXY=loopback

# --- Voice transcription ---
# local runs whisper.cpp; openai uploads audio to the configured provider.
# WAZAP_TRANSCRIBE=off
# WAZAP_TRANSCRIBE_AUTO=1
# Set the final OpenAI-compatible base URL: redirects are refused, as are
# userinfo credentials, query strings and fragments. HTTP is loopback-only.
# WAZAP_TRANSCRIBE_URL=https://api.openai.com/v1
# WAZAP_TRANSCRIBE_API_KEY=
# WAZAP_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Local semantic recall ("living memory") ---
# Indexes message text with a local embedding model, so `recall` finds messages
# by meaning — including ones that fell out of the in-memory caps. Needs
# llama.cpp (`brew install llama.cpp`) and a downloaded model
# (`wazap embed download`). Off when unset, and off whenever
# WAZAP_PERSIST_HISTORY=0: derived data must not outlive its source.
# WAZAP_RECALL=off

# Which embedding model: embeddinggemma-300m (default, ~320MB, 768d) or
# e5-base-multilingual (~290MB). Switching models rebuilds the index.
# WAZAP_EMBED_MODEL=embeddinggemma-300m

# llama-server binary override (e.g. a self-built one not on PATH).
# WAZAP_EMBED_BIN=

# Minutes the shared llama-server may sit unused before it is stopped; the
# next recall or indexing batch spawns it again (a few seconds of model
# load). 0 keeps it resident forever.
# WAZAP_EMBED_IDLE_MINUTES=30

# Index rows kept per account; the oldest are evicted past this.
# WAZAP_RECALL_MAX=50000

# Cosine floor a match must clear, 0..1 — under it, hits are noise, not
# answers. The default is per-model, measured on a real index: 0.35 on
# embeddinggemma-300m separates cleanly; e5-base-multilingual's noise and
# real hits overlap, so its 0.85 errs toward silence — gemma is the
# recommended model.
# WAZAP_RECALL_MIN_SIMILARITY=0.35

# --- Outbound webhook (inbound messages; the other events are opt-in) ---
# On without a URL or secret fails status, doctor and setup.
# An account may override the URL, secret and events in accounts.json
# (webhook_url, webhook_secret, webhook_events). wazap webhook test
# --account x uses those.
# WAZAP_WEBHOOK=off
# Redirects are refused. Query tokens are allowed; userinfo and fragments are not.
# WAZAP_WEBHOOK_URL=https://example.com/hooks/wazap
# WAZAP_WEBHOOK_SECRET=

# Which events get posted, comma-separated, or all for every one of them.
# Unset is message_received only, so a consumer that answers every POST is
# never made to answer messages you typed on the phone. message_sent and
# connection arrive only if you ask for them here.
# WAZAP_WEBHOOK_EVENTS=message_received
